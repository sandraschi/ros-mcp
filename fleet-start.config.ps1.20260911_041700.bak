# Per-repo fleet start config for ros-mcp
# Edit ports/backend target here - start.ps1 is fleet-standard.
@{
    Name         = 'ros-mcp'
    BackendPort  = 11050
    FrontendPort = 11051
    HealthPath   = '/health'
    WebRoot      = 'web_sota'
    Backend = @{
        Kind       = 'module-serve'
        Module     = 'ros_mcp'
        SyncExtras = @('dev')
    }
    Frontend = @{
        Kind           = 'vite-npm'
        PackageManager = 'npm'
        PortEnvVar     = 'VITE_PORT'
        ApiTargetEnv   = 'VITE_API_TARGET'
    }
}
